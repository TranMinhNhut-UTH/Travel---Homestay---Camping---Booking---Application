  "item": [
    {
      "name": "Folder 1: /api/vehicles/* (Vehicle Management)",
      "item": [
        {
          "name": "TC_001_Create_Vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Đổi status mong muốn sang 200 hoặc 211 tùy Backend của bạn quy định khi tạo thành công\r",
                  "pm.test(\"Status code is 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201); \r",
                  "});\r",
                  "\r",
                  "pm.test(\"Lưu vehicle id\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    // Đảm bảo trường id trả về từ backend đúng tên là 'id' (hoặc '_id', 'vehicleId'...)\r",
                  "    pm.expect(jsonData).to.have.property('id');\r",
                  "    pm.environment.set(\"current_vehicle_id\", jsonData.id);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"Model\": \"Mustang\",\r\n  \"Type\": \"Coupe\",\r\n  \"Price\": 55999.99,\r\n  \"BatteryCapacity\": 85.5,\r\n  \"Range\": 320,\r\n  \"StockQuantity\": 5,\r\n  \"Description\": \"Test vehicle from CI\",\r\n  \"DealerId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/vehicles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            }
          },
          "response": []
        },
