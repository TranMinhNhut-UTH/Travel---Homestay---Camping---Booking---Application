        {
          "name": "TC_003_Get_Vehicle_By_ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Kiểm tra ID xe trả về khớp\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    var expectedId = pm.environment.get(\"current_vehicle_id\");\r",
                  "    pm.expect(jsonData.id).to.eql(expectedId);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/vehicles/{{current_vehicle_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vehicles",
                "{{current_vehicle_id}}"
              ]
            }
          },
          "response": []
        }
      ]
