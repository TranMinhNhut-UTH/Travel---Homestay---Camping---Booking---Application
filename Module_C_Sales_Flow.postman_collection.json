    {
      "name": "1. POST - Tạo Báo Giá (Create Quote)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200/201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test('Cấu trúc JSON phản hồi hợp lệ', function () {",
              "    var jsonData = pm.response.json();",
              "    var quoteId = jsonData.quoteId ?? jsonData.id ?? jsonData.QuoteId;",
              "    pm.expect(quoteId, 'quote id should be returned').to.be.ok;",
              "    pm.environment.set('current_quote_id', String(quoteId));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 1,\n  \"dealerId\": 1,\n  \"salespersonId\": 1,\n  \"vehicleId\": 1,\n  \"colorId\": 1,\n  \"quantity\": 5,\n  \"unitPrice\": 150,\n  \"totalPrice\": 750,\n  \"status\": \"Active\",\n  \"notes\": \"Created by Postman smoke test\"\n}"
        },
        "url": "{{salesServiceUrl}}/api/Quotes"
