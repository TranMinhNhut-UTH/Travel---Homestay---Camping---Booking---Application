            "exec": [
              "// 1. Kiểm tra HTTP Status Code thành công\r",
              "pm.test(\"Status code là 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Kiểm tra cấu trúc dữ liệu trả về\r",
              "pm.test(\"Cấu trúc JSON phản hồi hợp lệ\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    pm.expect(jsonData).to.have.property(\"quoteId\");\r",
              "    pm.expect(jsonData).to.have.property(\"status\");\r",
              "    \r",
              "    // Lưu biến môi trường để dùng cho bước sau (Convert to Order)\r",
              "    pm.environment.set(\"current_quote_id\", jsonData.quoteId);\r",
              "});"
