{
  "info": {
    "_postman_id": "sales-flow-automated-test",
    "name": "Module C - Sales Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. POST - Tạo Báo Giá (Create Quote)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Cấu trúc JSON phản hồi hợp lệ\", function () {",
              "    var jsonData = pm.response.json();",
              "    var hasId = jsonData.hasOwnProperty('id') || jsonData.hasOwnProperty('Id') || jsonData.hasOwnProperty('quoteId') || jsonData.hasOwnProperty('QuoteId');",
              "    pm.expect(hasId).to.be.true;",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    try {",
              "        var jsonData = pm.response.json();",
              "        var extractedId = jsonData.id || jsonData.Id || jsonData.quoteId || jsonData.QuoteId;",
              "        pm.environment.set(\"quoteId\", extractedId);",
              "        console.log('Đã lưu Quote ID thành công:', extractedId);",
              "    } catch(e) {",
              "        console.error('Không thể gán biến ID: ' + e.message);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"CUST-9921\",\n  \"productId\": \"PROD-001\",\n  \"quantity\": 5,\n  \"unitPrice\": 150\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5003/api/Quotes",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5003",
          "path": [
            "api",
            "Quotes"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. POST - Chuyển Quote thành Order (Convert to Order)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 201 Created hoặc 200 OK\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    try {",
              "        var jsonData = pm.response.json();",
              "        var orderId = jsonData.id || jsonData.Id || jsonData.orderId || jsonData.OrderId;",
              "        pm.environment.set(\"orderId\", orderId);",
              "        console.log('Đã lưu Order ID thành công:', orderId);",
              "    } catch(e) {",
              "        console.error('Không thể lấy orderId từ phản hồi: ' + e.message);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quoteId\": {{quoteId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5003/api/Orders",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5003",
          "path": [
            "api",
            "Orders"
          ]
        }
      },
      "response": []
    },
