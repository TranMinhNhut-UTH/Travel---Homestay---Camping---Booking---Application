      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"P@ssw0rd!\"\n}" },
            "url": "{{baseUrl}}/api/auth/login",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Login succeeds', function () {",
                    "  pm.response.to.have.status(200);",
                    "});",
                    "let response = {};",
                    "try { response = pm.response.json(); } catch (error) { response = {}; }",
                    "const token = response.accessToken || response.token || response.access_token || response.result?.accessToken || response.data?.accessToken || response.data?.token;",
                    "if (token) {",
                    "  pm.collectionVariables.set('authToken', token);",
                    "  pm.environment.set('authToken', token);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
